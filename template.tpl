___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const injectScript = require('injectScript');
const createQueue = require('createQueue');
const logToConsole = require('logToConsole');

// Load LiveTag script
const qjsUrl = 'https://secure.quantserve.com/quant.js';
injectScript(qjsUrl, data.gtmOnSuccess, data.gtmOnFailure, 'quantcast-livetag');

// required fields
const pcode = data.pcode;
const labels = data.labels;

// optional fields
const revenue = data.revenue;
const orderId = data.orderId;
const externalId = data.externalId;

const qEvent = {
  "qacct": pcode,
  "labels": labels,
  "event": "refresh",
  "source": "gtm-template",
};

if (revenue) {
  qEvent.revenue = revenue;
}
if (orderId) {
  qEvent.orderid = orderId;
}
if (externalId) {
  qEvent.external_id = externalId;
}

// Append Custom Parameters from the table
if (data.extraParams) {
  for (let i = 0; i < data.extraParams.length; i++) {
    const param = data.extraParams[i];
    if (param.key) {
      if (qEvent[param.key] !== undefined) {
        logToConsole('Quantcast LiveTag: ignoring extra parameter "' + param.key + '" because it would overwrite an existing value');
      } else {
        qEvent[param.key] = param.value;
      }
    }
  }
}

const qeventsPush = createQueue('_qevents');
qeventsPush(qEvent);


