___TESTS___

scenarios:
- name: Required fields only produce a well-formed qEvent
  code: |-
    let pushed;
    mock('createQueue', (name) => {
      assertThat(name).isEqualTo('_qevents');
      return (evt) => { pushed = evt; };
    });

    runCode({
      pcode: "p-1234",
      labels: "_fp.event.PageView"
    });

    assertThat(pushed).isDefined();
    assertThat(pushed.qacct).isEqualTo("p-1234");
    assertThat(pushed.labels).isEqualTo("_fp.event.PageView");
    assertThat(pushed.event).isEqualTo("refresh");
    assertThat(pushed.source).isEqualTo("gtm-template");
    assertThat(pushed.revenue).isUndefined();
    assertThat(pushed.orderid).isUndefined();
    assertThat(pushed.external_id).isUndefined();
- name: All optional fields are appended when provided
  code: |-
    let pushed;
    mock('createQueue', () => (evt) => { pushed = evt; });

    runCode({
      pcode: "p-1234",
      labels: "_fp.event.Purchase",
      revenue: "42.50",
      orderId: "order-987",
      externalId: "user-abc"
    });

    assertThat(pushed.revenue).isEqualTo("42.50");
    assertThat(pushed.orderid).isEqualTo("order-987");
    assertThat(pushed.external_id).isEqualTo("user-abc");
- name: Empty-string optional fields are omitted
  code: |-
    let pushed;
    mock('createQueue', () => (evt) => { pushed = evt; });

    runCode({
      pcode: "p-1234",
      labels: "_fp.event.PageView",
      revenue: "",
      orderId: "",
      externalId: ""
    });

    assertThat(pushed.revenue).isUndefined();
    assertThat(pushed.orderid).isUndefined();
    assertThat(pushed.external_id).isUndefined();
- name: Extra parameters from the table are appended
  code: |-
    let pushed;
    mock('createQueue', () => (evt) => { pushed = evt; });

    runCode({
      pcode: "p-1234",
      labels: "_fp.event.PageView",
      extraParams: [
        { key: "campaign", value: "summer" },
        { key: "medium", value: "email" }
      ]
    });

    assertThat(pushed.campaign).isEqualTo("summer");
    assertThat(pushed.medium).isEqualTo("email");
- name: Extra parameters with an empty key are skipped
  code: |-
    let pushed;
    mock('createQueue', () => (evt) => { pushed = evt; });

    runCode({
      pcode: "p-1234",
      labels: "_fp.event.PageView",
      extraParams: [
        { key: "", value: "ignored" },
        { key: "kept", value: "yes" }
      ]
    });

    assertThat(pushed.kept).isEqualTo("yes");
    assertThat(pushed[""]).isUndefined();
- name: Extra parameters cannot overwrite built-in keys
  code: |-
    let pushed;
    mock('createQueue', () => (evt) => { pushed = evt; });

    runCode({
      pcode: "p-1234",
      labels: "_fp.event.PageView",
      revenue: "42.50",
      extraParams: [
        { key: "qacct", value: "p-evil" },
        { key: "event", value: "hijack" },
        { key: "labels", value: "spoofed" },
        { key: "revenue", value: "0.00" }
      ]
    });

    assertThat(pushed.qacct).isEqualTo("p-1234");
    assertThat(pushed.event).isEqualTo("refresh");
    assertThat(pushed.labels).isEqualTo("_fp.event.PageView");
    assertThat(pushed.revenue).isEqualTo("42.50");
    assertApi('logToConsole').wasCalled();
- name: Later duplicate extra parameter does not overwrite an earlier one
  code: |-
    let pushed;
    mock('createQueue', () => (evt) => { pushed = evt; });

    runCode({
      pcode: "p-1234",
      labels: "_fp.event.PageView",
      extraParams: [
        { key: "campaign", value: "summer" },
        { key: "campaign", value: "winter" }
      ]
    });

    assertThat(pushed.campaign).isEqualTo("summer");
    assertApi('logToConsole').wasCalled();
- name: Missing extraParams table does not break the tag
  code: |-
    let pushed;
    mock('createQueue', () => (evt) => { pushed = evt; });

    runCode({
      pcode: "p-1234",
      labels: "_fp.event.PageView"
    });

    assertThat(pushed).isDefined();
    assertThat(pushed.qacct).isEqualTo("p-1234");
- name: Script injection succeeds and calls gtmOnSuccess
  code: |-
    mock('createQueue', () => () => {});
    mock('injectScript', (url, onSuccess, onFailure, id) => {
      assertThat(url).isEqualTo('https://secure.quantserve.com/quant.js');
      onSuccess();
    });

    runCode({
      pcode: "p-1234",
      labels: "_fp.event.PageView"
    });

    assertApi('gtmOnSuccess').wasCalled();
- name: Script injection failure calls gtmOnFailure
  code: |-
    mock('createQueue', () => () => {});
    mock('injectScript', (url, onSuccess, onFailure, id) => {
      onFailure();
    });

    runCode({
      pcode: "p-1234",
      labels: "_fp.event.PageView"
    });

    assertApi('gtmOnFailure').wasCalled();


